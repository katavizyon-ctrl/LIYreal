<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LIYreal &#8212; Ankara Mohair for Body and Room</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@200;300;400;500&display=swap" rel="stylesheet">
<style>
/* ─── RESET ─── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --iv:#f5f0e8;
  --hn:#c4956a;
  --hnp:#dbbf96;
  --st:#a8896b;
  --std:#7a6248;
  --stp:#cbb898;
  --ink:#0e0d0a;
  --ink2:#131109;
  --ink3:#1a1814;
  --mu:#857e74;
  --mu2:#5c5549;
  --dv:rgba(196,149,106,.14);
  --dv2:rgba(196,149,106,.06);
  --sf:'Cormorant Garamond',serif;
  --ss:'DM Sans',sans-serif;
}
html{scroll-behavior:smooth}
body{background:var(--ink);color:var(--iv);font-family:var(--ss);font-weight:300;overflow-x:hidden;-webkit-font-smoothing:antialiased;cursor:none}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
button,input,select,textarea{font-family:inherit}
.page{display:none}.page.active{display:block}

/* ─── CURSOR ─── */
#cur{width:6px;height:6px;background:var(--hn);border-radius:50%;position:fixed;pointer-events:none;z-index:9999;top:0;left:0;transform:translate(-50%,-50%);transition:width .2s,height .2s;mix-blend-mode:screen;will-change:transform}
#cur.big{width:34px;height:34px;opacity:.2}

/* ─── NAV ─── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:900;
  background:rgba(14,13,10,.96);
  border-bottom:1px solid var(--dv);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  display:flex;justify-content:space-between;align-items:center;
  padding:1.4rem 4rem;
  transition:padding .4s;
}
nav.top{padding:1.8rem 4rem}
.logo{display:flex;flex-direction:column;gap:3px;cursor:none}
.logo-wm{display:flex;align-items:baseline;gap:1px}
.logo-liy{font-family:var(--ss);font-weight:500;font-size:.9rem;letter-spacing:.32em;color:var(--iv);line-height:1}
.logo-real{font-family:var(--ss);font-weight:200;font-size:.9rem;letter-spacing:.15em;color:var(--iv);line-height:1}
.logo-sub{font-size:.38rem;letter-spacing:.5em;text-transform:uppercase;color:var(--hn)}
.nav-links{display:flex;gap:2.5rem;list-style:none;align-items:center}
.nav-links a{
  font-size:.52rem;letter-spacing:.24em;text-transform:uppercase;
  color:rgba(245,240,232,.65);
  transition:color .25s;cursor:none;padding:.3rem 0;
  position:relative;
}
.nav-links a::after{
  content:'';position:absolute;bottom:-2px;left:0;width:0;height:1px;
  background:var(--hn);transition:width .3s;
}
.nav-links a:hover{color:var(--iv)}
.nav-links a:hover::after,.nav-links a.on::after{width:100%}
.nav-links a.on{color:var(--iv)}
.nav-reserve{
  background:var(--hn)!important;
  color:var(--ink)!important;
  padding:.55rem 1.6rem!important;
  font-weight:400!important;
  letter-spacing:.22em!important;
  transition:background .3s,color .3s!important;
}
.nav-reserve::after{display:none!important}
.nav-reserve:hover{background:var(--iv)!important;color:var(--ink)!important}
.nav-tog{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:none;padding:4px}
.nav-tog span{display:block;width:22px;height:1px;background:var(--iv);transition:all .3s}

/* ─── ANIMS ─── */
@keyframes fup{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
@keyframes fin{from{opacity:0}to{opacity:1}}
.fi{opacity:0;transform:translateY(18px);transition:opacity .8s ease,transform .8s ease}
.fi.v{opacity:1;transform:none}
.d1{transition-delay:.1s}.d2{transition-delay:.2s}.d3{transition-delay:.32s}.d4{transition-delay:.46s}.d5{transition-delay:.62s}

/* ─── SHARED ─── */
.eyebrow{font-size:.44rem;letter-spacing:.52em;text-transform:uppercase;color:var(--hn);display:flex;align-items:center;gap:1rem}
.eyebrow::before{content:'';width:16px;height:.5px;background:var(--hn);flex-shrink:0}
.section-rule{display:flex;align-items:center;gap:2rem;padding:0 4rem}
.section-rule::before,.section-rule::after{content:'';flex:1;height:.5px;background:var(--dv)}
.section-rule span{font-size:.42rem;letter-spacing:.5em;text-transform:uppercase;color:var(--hn);white-space:nowrap}
.btn{display:inline-flex;align-items:center;gap:1.2rem;background:transparent;border:1px solid var(--st);color:var(--iv);padding:1rem 2.4rem;font-family:var(--ss);font-size:.5rem;font-weight:400;letter-spacing:.32em;text-transform:uppercase;cursor:none;transition:all .35s}
.btn:hover{background:var(--st);color:var(--ink);gap:1.6rem}
.btn-outline{border-color:var(--dv);color:var(--mu)}
.btn-outline:hover{border-color:var(--st);color:var(--stp);background:transparent}
.btn-fill{background:var(--hn);border-color:var(--hn);color:var(--ink)}
.btn-fill:hover{background:var(--iv);border-color:var(--iv)}
.arr{transition:transform .3s}.btn:hover .arr{transform:translateX(4px)}
.form-field{display:flex;flex-direction:column;gap:.4rem}
.form-label{font-size:.42rem;letter-spacing:.34em;text-transform:uppercase;color:var(--mu)}
.form-input{background:transparent;border:none;border-bottom:1px solid var(--dv);color:var(--iv);padding:.7rem 0;font-size:.84rem;outline:none;transition:border-color .3s;width:100%}
.form-input:focus{border-color:var(--hn)}
.form-input::placeholder{color:var(--mu2)}
.form-select{background:rgba(14,13,10,.9);border:1px solid var(--dv);color:var(--iv);padding:.75rem 1rem;font-size:.82rem;outline:none;transition:border-color .3s;width:100%;appearance:none;cursor:none}
.form-select:focus{border-color:var(--hn)}
.form-select option{background:#1a1814}

/* ─── HOME HERO ─── */
.hero{
  height:100vh;min-height:600px;
  display:grid;grid-template-columns:55% 45%;
  overflow:hidden;
  padding-top:0;
}
.hero-img{position:relative;overflow:hidden}
.hero-photo{
  position:absolute;inset:0;
  background-image:url("data:image/png;base64,");
  background-size:cover;background-position:center top;
  filter:brightness(.82);
  transition:transform 20s ease;
}
.page.active .hero-photo{transform:scale(1.05)}
.hero-grain{
  position:absolute;inset:0;pointer-events:none;opacity:.35;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.05'/%3E%3C/svg%3E");
}
.hero-caption{
  position:absolute;bottom:2rem;left:2.5rem;
  font-size:.38rem;letter-spacing:.42em;text-transform:uppercase;
  color:rgba(245,240,232,.28);
  opacity:0;animation:fin 1s 2s ease forwards;
}
.hero-copy{
  background:var(--ink2);
  display:flex;flex-direction:column;justify-content:flex-end;
  padding:6rem 5rem 6.5rem;
  position:relative;
}
.hero-copy::before{
  content:'';position:absolute;top:0;left:0;width:1px;height:100%;
  background:linear-gradient(to bottom,transparent 0%,rgba(196,149,106,.22) 50%,transparent 100%);
}
.h-eye{font-size:.44rem;letter-spacing:.56em;text-transform:uppercase;color:var(--hn);margin-bottom:3.5rem;opacity:0;animation:fup .65s .25s ease forwards}
.h-title{font-family:var(--sf);font-size:clamp(4rem,6.8vw,7rem);font-weight:300;line-height:.84;color:var(--iv);margin-bottom:2.8rem;opacity:0;animation:fup .85s .45s ease forwards}
.h-title em{font-style:italic;color:var(--hnp);display:block}
.h-desc{font-family:var(--sf);font-style:italic;font-size:1.05rem;color:var(--mu);line-height:1.9;max-width:28ch;margin-bottom:4rem;opacity:0;animation:fup .85s .65s ease forwards}
.h-worlds{display:flex;gap:0;margin-bottom:4rem;opacity:0;animation:fup .85s .82s ease forwards}
.h-world{
  flex:1;padding:1.3rem 1rem;
  border:1px solid var(--dv);border-right:none;
  cursor:none;transition:all .3s;
  display:flex;flex-direction:column;gap:.45rem;
  position:relative;overflow:hidden;
}
.h-world:last-child{border-right:1px solid var(--dv)}
.h-world::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:1px;
  background:var(--hn);transform:scaleX(0);transform-origin:left;transition:transform .35s;
}
.h-world:hover{background:rgba(196,149,106,.05);border-color:rgba(196,149,106,.3)}
.h-world:hover::after{transform:scaleX(1)}
.hw-num{font-size:.36rem;letter-spacing:.52em;text-transform:uppercase;color:var(--hn)}
.hw-title{font-family:var(--sf);font-size:1rem;font-weight:300;color:var(--iv)}
.h-actions{display:flex;gap:1rem;flex-wrap:wrap;opacity:0;animation:fup .85s .98s ease forwards}
.h-stamp{
  position:absolute;bottom:5rem;left:4.5rem;
  width:72px;height:72px;border:1px solid rgba(196,149,106,.15);border-radius:50%;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;
  opacity:0;animation:fin .8s 1.6s ease forwards;
}
.hs-l{font-family:var(--ss);font-weight:500;font-size:10px;letter-spacing:.2em;color:var(--iv)}
.hs-r{font-family:var(--ss);font-weight:200;font-size:10px;letter-spacing:.1em;color:var(--iv)}
.hs-line{width:20px;height:.5px;background:var(--st);margin:1px 0}
.hs-sub{font-size:4px;letter-spacing:.32em;color:var(--hn);text-transform:uppercase}

/* ─── STORY PILLARS ─── */
.pillars{
  padding:9rem 4rem;
  display:grid;grid-template-columns:repeat(3,1fr);
  border-top:1px solid var(--dv);
}
.pillar{
  padding:0 3rem;border-right:1px solid var(--dv);
  display:flex;flex-direction:column;gap:1.8rem;
}
.pillar:first-child{padding-left:0}
.pillar:last-child{border-right:none;padding-right:0}
.p-num{font-family:var(--sf);font-size:6rem;font-weight:300;color:rgba(196,149,106,.08);line-height:1;margin-bottom:-.5rem}
.p-label{font-size:.42rem;letter-spacing:.48em;text-transform:uppercase;color:var(--hn)}
.p-title{font-family:var(--sf);font-size:2.1rem;font-weight:300;line-height:1;color:var(--iv)}
.p-title em{font-style:italic;color:var(--hnp)}
.p-body{font-size:.8rem;line-height:2.05;color:var(--mu);max-width:30ch}
.p-link{
  display:inline-flex;align-items:center;gap:.8rem;
  font-size:.44rem;letter-spacing:.34em;text-transform:uppercase;color:var(--hn);
  cursor:none;border-bottom:1px solid rgba(196,149,106,.2);padding-bottom:.45rem;
  width:fit-content;transition:gap .3s,border-color .3s;margin-top:auto;
}
.p-link:hover{gap:1.3rem;border-color:var(--hn)}

/* ─── MATERIAL SECTION ─── */
.material{border-top:1px solid var(--dv);display:grid;grid-template-columns:1fr 1fr;min-height:75vh}
.mat-visual{position:relative;overflow:hidden}
.mat-photo{
  position:absolute;inset:0;
  background-image:url("data:image/png;base64,");
  background-size:cover;background-position:center;
  filter:brightness(.76);
}
.mat-photo-ov{
  position:absolute;inset:0;
  background:linear-gradient(to right,transparent 55%,var(--ink2) 100%);
}
.mat-copy{
  background:var(--ink2);
  display:flex;flex-direction:column;justify-content:center;
  padding:6rem 5rem 6rem 6.5rem;position:relative;
}
.mat-copy::before{content:'';position:absolute;top:0;left:0;width:1px;height:100%;background:linear-gradient(to bottom,transparent,rgba(196,149,106,.16),transparent)}
.mat-pull{font-family:var(--sf);font-size:clamp(2rem,3.4vw,3.2rem);font-weight:300;line-height:1.1;color:var(--iv);margin:2.5rem 0}
.mat-pull em{font-style:italic;color:var(--hnp)}
.mat-body{font-size:.83rem;line-height:2.1;color:var(--mu);max-width:36ch;margin-bottom:3rem}
.mat-specs{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem 2.5rem;border-top:1px solid var(--dv);padding-top:2.5rem}
.spec-label{font-size:.4rem;letter-spacing:.42em;text-transform:uppercase;color:var(--hn);margin-bottom:.3rem}
.spec-val{font-family:var(--sf);font-size:1rem;font-weight:300;color:var(--iv)}

/* ─── OBJECTS GRID ─── */
.objects{padding:9rem 4rem;border-top:1px solid var(--dv)}
.objects-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:5rem}
.objects-title{font-family:var(--sf);font-size:clamp(2.8rem,4.5vw,4.5rem);font-weight:300;line-height:.9;color:var(--iv)}
.objects-title em{font-style:italic;color:var(--hnp);display:block}
.og{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
.og-card{cursor:none;position:relative}
.og-img-wrap{position:relative;overflow:hidden;aspect-ratio:2/3}
.og-img-wrap::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(to top,rgba(14,13,10,.7) 0%,transparent 50%);
  transition:opacity .4s;
}
.og-card:hover .og-img-wrap::after{opacity:.8}
.og-img{width:100%;height:100%;object-fit:cover;transition:transform .9s ease;filter:brightness(.86)}
.og-card:hover .og-img{transform:scale(1.06)}
.og-meta{padding:1.5rem 0 .4rem;display:flex;flex-direction:column;gap:.35rem}
.og-world{font-size:.38rem;letter-spacing:.44em;text-transform:uppercase;color:var(--hn)}
.og-name{font-family:var(--sf);font-size:1.4rem;font-weight:300;color:var(--iv)}
.og-price{font-family:var(--sf);font-size:1.05rem;color:var(--stp)}
.og-badge{
  position:absolute;top:1.2rem;right:1.2rem;
  font-size:.36rem;letter-spacing:.32em;text-transform:uppercase;
  background:rgba(14,13,10,.88);color:var(--hn);
  border:1px solid rgba(196,149,106,.2);padding:.35rem .8rem;
  backdrop-filter:blur(6px);
}

/* ─── ARCHIVE SPLIT ─── */
.archive-split{border-top:1px solid var(--dv);display:grid;grid-template-columns:52% 48%;min-height:88vh}
.arch-visual{position:relative;overflow:hidden}
.arch-photo{
  position:absolute;inset:0;
  background-image:url("data:image/png;base64,");
  background-size:cover;background-position:center 18%;
  filter:brightness(.78);
  transition:transform 1.2s ease;
}
.archive-split:hover .arch-photo{transform:scale(1.04)}
.arch-photo-ov{position:absolute;inset:0;background:linear-gradient(to right,transparent 58%,var(--ink2) 100%)}
.arch-copy{
  background:var(--ink2);display:flex;flex-direction:column;justify-content:center;
  padding:6rem 5.5rem;position:relative;
}
.arch-no{position:absolute;top:3rem;right:3.5rem;text-align:right}
.arch-no-num{font-family:var(--sf);font-size:4rem;font-weight:300;color:rgba(196,149,106,.07);line-height:1}
.arch-no-label{font-size:.36rem;letter-spacing:.42em;text-transform:uppercase;color:var(--mu2)}
.arch-edition{font-size:.4rem;letter-spacing:.44em;text-transform:uppercase;color:var(--mu);margin-bottom:.8rem}
.arch-title{font-family:var(--sf);font-size:clamp(3rem,5.5vw,5.5rem);font-weight:300;line-height:.88;color:var(--iv);margin-bottom:1.2rem}
.arch-title em{font-style:italic;color:var(--hnp);display:block}
.arch-body{font-family:var(--sf);font-style:italic;font-size:1.05rem;color:var(--mu);line-height:1.85;max-width:32ch;margin-bottom:2.8rem}
.arch-stones{display:flex;flex-wrap:wrap;gap:.7rem;margin-bottom:3.5rem}
.arch-stone{padding:.75rem 1.1rem;border:1px solid var(--dv);transition:border-color .3s;cursor:none}
.arch-stone:hover{border-color:rgba(196,149,106,.3)}
.arch-stone-origin{font-size:.38rem;letter-spacing:.3em;text-transform:uppercase;color:var(--hn);margin-bottom:.2rem}
.arch-stone-name{font-family:var(--sf);font-size:.88rem;font-weight:300;color:var(--iv)}
.arch-actions{display:flex;gap:1rem;flex-wrap:wrap}

/* ─── CLOSEUP FULL BLEED ─── */
.closeup{
  border-top:1px solid var(--dv);
  position:relative;overflow:hidden;height:58vh;
}
.closeup-photo{
  position:absolute;inset:0;
  background-image:url("data:image/png;base64,");
  background-size:cover;background-position:center 40%;
  filter:brightness(.78);
}
.closeup-ov{
  position:absolute;inset:0;
  background:linear-gradient(100deg,rgba(14,13,10,.82) 0%,rgba(14,13,10,.1) 55%,rgba(14,13,10,.6) 100%);
}
.closeup-content{
  position:absolute;inset:0;
  display:flex;align-items:flex-end;justify-content:space-between;
  padding:3.5rem 4rem;
}
.closeup-left{max-width:44ch}
.closeup-label{font-size:.42rem;letter-spacing:.48em;text-transform:uppercase;color:var(--hn);margin-bottom:.8rem}
.closeup-quote{font-family:var(--sf);font-style:italic;font-size:clamp(1.4rem,2.8vw,2.6rem);font-weight:300;color:var(--iv);line-height:1.18}
.closeup-right{text-align:right}
.closeup-caption{font-size:.38rem;letter-spacing:.4em;text-transform:uppercase;color:rgba(245,240,232,.28)}

/* ─── STRIP ─── */
.strip{border-top:1px solid var(--dv)}
.strip-header{padding:2.5rem 4rem 2rem;font-size:.4rem;letter-spacing:.5em;text-transform:uppercase;color:var(--hn)}
.strip-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:.4rem;padding:0 4rem 4rem}
.strip-cell{overflow:hidden;cursor:none}
.strip-img{width:100%;aspect-ratio:4/5;object-fit:cover;filter:brightness(.72);transition:transform .8s ease,filter .4s}
.strip-cell:hover .strip-img{transform:scale(1.08);filter:brightness(.94)}

/* ─── WAITLIST ─── */
.waitlist{
  padding:9rem 4rem;border-top:1px solid var(--dv);
  display:grid;grid-template-columns:1fr 1fr;gap:10rem;align-items:center;
}
.wl-title{font-family:var(--sf);font-size:clamp(2.8rem,4.5vw,4.5rem);font-weight:300;line-height:.92;color:var(--iv);margin:2rem 0 1.5rem}
.wl-title em{font-style:italic;color:var(--hnp);display:block}
.wl-body{font-size:.83rem;line-height:2.05;color:var(--mu)}
.wl-form{display:flex;flex-direction:column;gap:1.4rem}
.wl-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.wl-note{font-size:.7rem;color:var(--mu2);line-height:1.75}
.wl-success{display:none;padding:2rem;border:1px solid rgba(196,149,106,.22);background:rgba(196,149,106,.04)}
.wl-success.show{display:block}
.wl-success-title{font-family:var(--sf);font-size:1.5rem;color:var(--iv);margin-bottom:.4rem}
.wl-success-body{font-size:.8rem;color:var(--mu);line-height:1.8}
.btn-submit{
  display:inline-flex;align-items:center;gap:1.2rem;
  background:var(--hn);border:none;color:var(--ink);
  padding:1.1rem 2.6rem;font-family:var(--ss);font-size:.5rem;font-weight:400;
  letter-spacing:.34em;text-transform:uppercase;cursor:none;transition:all .35s;
}
.btn-submit:hover{background:var(--iv);gap:1.6rem}

/* ─── PAGE HERO (inner pages) ─── */
.page-hero{height:90vh;position:relative;overflow:hidden;display:flex;align-items:flex-end}
.page-hero-img{position:absolute;inset:0;background-size:cover;background-repeat:no-repeat}
.page-hero-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(14,13,10,.92) 0%,rgba(14,13,10,.22) 55%,transparent 100%)}
.page-hero-content{position:relative;z-index:1;padding:5.5rem 4rem;max-width:780px}
.ph-eye{margin-bottom:2.5rem;opacity:0;animation:fup .65s .3s ease forwards}
.ph-title{font-family:var(--sf);font-size:clamp(5rem,9vw,9rem);font-weight:300;line-height:.85;color:var(--iv);opacity:0;animation:fup .85s .5s ease forwards}
.ph-title em{font-style:italic;color:var(--hnp)}
.ph-sub{font-family:var(--sf);font-style:italic;font-size:1.1rem;color:var(--mu);line-height:1.85;max-width:36ch;margin-top:1.5rem;opacity:0;animation:fup .85s .7s ease forwards}

/* ─── BODY PRODUCT FEATURE ─── */
.products{padding:9rem 4rem;border-top:1px solid var(--dv)}
.products-intro{display:grid;grid-template-columns:1fr 2fr;gap:5rem;margin-bottom:8rem;align-items:end}
.pi-title{font-family:var(--sf);font-size:3rem;font-weight:300;line-height:1;color:var(--iv);margin-top:1.5rem}
.pi-body{font-size:.83rem;line-height:2.1;color:var(--mu)}
.product-feat{display:grid;grid-template-columns:1.1fr 1fr;gap:7rem;align-items:start;margin-bottom:9rem;padding-bottom:9rem;border-bottom:1px solid var(--dv)}
.product-feat.rev{grid-template-columns:1fr 1.1fr}
.product-feat.rev .pf-gallery{order:2}
.product-feat.rev .pf-info{order:1}
.pf-gallery{display:grid;grid-template-columns:1fr 1fr;gap:.45rem}
.pf-main{grid-column:1/-1;overflow:hidden}
