<script>
var cur = document.getElementById('cur');
document.addEventListener('mousemove', function(e) {
  cur.style.left = e.clientX + 'px';
  cur.style.top = e.clientY + 'px';
});
document.querySelectorAll('a, button, .og-card, .h-world, .arch-visual, .stone-card, .fo-prod, .fo-item, .strip-cell').forEach(function(el) {
  el.addEventListener('mouseenter', function() { cur.classList.add('big'); });
  el.addEventListener('mouseleave', function() { cur.classList.remove('big'); });
});

window.addEventListener('scroll', function() {
  var nav = document.getElementById('mainNav');
  if (window.scrollY > 40) {
    nav.classList.remove('top');
  } else {
    nav.classList.add('top');
  }
});

function go(page) {
  document.querySelectorAll('.page').forEach(function(p) { p.classList.remove('active'); });
  var el = document.getElementById('page-' + page);
  if (el) el.classList.add('active');
  window.scrollTo({top: 0, behavior: 'instant'});
  document.querySelectorAll('.nav-links a').forEach(function(a) { a.classList.remove('on'); });
  var nl = document.getElementById('nl-' + page);
  if (nl) nl.classList.add('on');
  setTimeout(observe, 80);
}

function observe() {
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) { e.target.classList.add('v'); io.unobserve(e.target); }
    });
  }, {threshold: 0.1});
  document.querySelectorAll('.page.active .fi:not(.v)').forEach(function(el) { io.observe(el); });
}
observe();

function openMob() { document.getElementById('mobNav').classList.add('open'); document.body.style.overflow = 'hidden'; }
function closeMob() { document.getElementById('mobNav').classList.remove('open'); document.body.style.overflow = ''; }

document.querySelectorAll('.swatches').forEach(function(g) {
  g.querySelectorAll('.swatch').forEach(function(s) {
    s.addEventListener('click', function() {
      g.querySelectorAll('.swatch').forEach(function(x) { x.classList.remove('on'); });
      s.classList.add('on');
    });
  });
});

function submitWL() {
  document.getElementById('wlForm').style.display = 'none';
  document.getElementById('wlSuccess').classList.add('show');
}
function submitFO() {
  document.getElementById('foSubBtn').style.display = 'none';
  document.getElementById('foSuccess').classList.add('show');
}
function toggleProd(el) {
  document.querySelectorAll('.fo-prod').forEach(function(p) { p.classList.remove('on'); });
  el.classList.add('on');
}
function selectP(name) {
  go('first');
  setTimeout(function() {
    document.getElementById('foForm').scrollIntoView({behavior: 'smooth'});
    document.querySelectorAll('.fo-prod').forEach(function(p) {
      p.classList.remove('on');
      if (p.querySelector('.fo-prod-name').textContent.indexOf(name) >= 0) p.classList.add('on');
    });
  }, 120);
}

